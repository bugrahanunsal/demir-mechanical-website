# Demir Mechanical & Construction - website + admin panel (Hostinger)
DirectoryIndex index.html index.php
Options -Indexes
ErrorDocument 404 /404.html

# Private: site content and passwords (data/), panel code (app/), mail library (lib/), development files and notes
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(app|data|lib|_dev|docs|\.git|\.github)(/|$) - [F,L]
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteRule ^(form-config(\.sample)?\.php|README\.md|CLAUDE\.md|composer\.(json|lock))$ - [F,L]
</IfModule>
<FilesMatch "^(form-config\.php|form-config\.sample\.php|.*\.md|.*\.log|\.gitignore|\.htaccess)$">
  Require all denied
</FilesMatch>

# Faster loading: compress text files
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json application/xml image/svg+xml
</IfModule>

# Let browsers keep images; always re-check pages so edits show up immediately
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
